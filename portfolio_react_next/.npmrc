# 워크스페이스 패키지는 항상 로컬 소스를 링크한다(레지스트리에 올라간 동명 패키지와 섞이지 않도록).
link-workspace-packages=true
prefer-workspace-packages=true

# 팬텀 의존성 차단: package.json 에 선언하지 않은 모듈은 import 할 수 없다.
# 20명 이상이 동시에 작업할 때 "내 PC 에선 되는데" 류의 사고를 구조적으로 막는다.
node-linker=isolated

# 엔진 필드를 강제해 Node 버전 불일치를 조기에 실패시킨다.
engine-strict=true
