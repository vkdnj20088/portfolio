# /etc/systemd/system/portfolio-backend.service
# Spring Boot jar(prod 프로파일). DB 는 같은 호스트의 Docker MySQL(127.0.0.1:3306) 이라
# docker.service 이후에 기동한다. Flyway 가 스키마를 자동 적용하므로 수동 스키마 준비가 없다.
#   sudo systemctl daemon-reload && sudo systemctl enable --now portfolio-backend
[Unit]
Description=Portfolio Backend (Spring Boot - extension block)
After=network.target docker.service
Wants=docker.service
# 기동이 계속 실패하면 5초마다 영원히 재시도하며 CPU 와 메모리를 태운다(실제로 겪음).
# 5분 안에 5번 실패하면 멈추고 failed 로 남긴다 - 사람이 로그를 보게 만드는 편이 낫다.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/portfolio/backend/current
EnvironmentFile=/etc/portfolio/backend.env
# 2GB 인스턴스(t4g.small)라 힙을 조이되, "기동을 실패시키는" 선까지 내려가지 않는다.
#  - -Xss512k 는 뺐다. 스레드 스택을 조이면 Spring 의 깊은 리플렉션 초기화에서 StackOverflow 로
#    부팅 자체가 실패할 수 있다. 절약량(스레드당 수백 KB)에 비해 위험이 크다.
#  - 힙은 320m 로 되돌린다(이전 운영값). Tika 파서까지 올라오는 앱이라 256m 는 여유가 없다.
#  - 메타스페이스 상한 96m 이 실제로 기동을 죽였다(OutOfMemoryError: Metaspace, Hibernate 의 SQM
#    변환 클래스 로딩 중). Spring Boot + Hibernate + Tika 는 클래스가 많아 150~250MB 로 수렴한다.
#    상한 자체는 유지하되(누수 시 폭주 방지) 수렴값 위인 256m 로 둔다 - 이 값은 "아끼는 곳"이 아니다.
#  - 직렬 GC 는 유지(코어 2개·저부하에 맞고 위험이 없다).
ExecStart=/usr/bin/java -Xmx320m -XX:MaxMetaspaceSize=256m -XX:+UseSerialGC \
  -jar app.jar --spring.profiles.active=prod
# Spring Boot 는 SIGTERM 종료 시 143 으로 빠지므로 실패로 보지 않는다.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# 하드닝. Next 세 유닛과 같은 세트로 맞춘다 - 이 유닛만 빠져 있었다.
#  - ProtectSystem=strict: /usr /boot /etc 가 읽기 전용이 된다. 앱이 쓰는 곳은 아래 하나뿐이다.
#  - PrivateTmp: 이 서비스만의 /tmp 를 준다. quarantine-dir 이 비어 있으면 앱은
#    {java.io.tmpdir}/quarantine 을 쓰는데(application.yml), 그게 이 사설 tmp 안으로 들어간다.
#    다른 프로세스가 격리 파일을 들여다볼 수 없고, 재시작 때 systemd 가 통째로 비워
#    "격리 파일 무한 적재" 문제도 함께 사라진다. 데모라 영속이 필요 없다.
#  - RestrictAddressFamilies: MySQL/HTTP 용 INET 과 JVM 내부용 UNIX 만 남긴다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/portfolio/backend
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
