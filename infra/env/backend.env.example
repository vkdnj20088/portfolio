# /etc/portfolio/backend.env  (권한 600, root:root). 실제 값으로 채우고 저장소엔 커밋하지 않는다.
# application-prod.yml 이 이 값들을 ${...} 로 주입한다. 스키마/시드는 Flyway 가 자동 적용한다.

# 같은 EC2 의 Docker MySQL(루프백 바인딩)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=extdb
DB_USER=extuser
DB_PASSWORD=__CHANGE_ME__

# 참고: 분산 락 프로바이더는 application-prod.yml 에서 mysql(GET_LOCK)로 고정돼 있다.
#       단일 인스턴스만 운영하면 로컬 프로파일 재정의로 in-process 로 둬도 무방하다.
